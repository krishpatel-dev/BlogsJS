<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Create New Post - My Blog</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&family=Playfair+Display:wght@700;900&display=swap" rel="stylesheet">
</head>
<body>
  <header class="header">
    <div class="header-content">
      <h1 class="logo"><a href="/" style="text-decoration: none; color: inherit;">✍️ My Blog</a></h1>
      <nav>
        <a href="/" class="nav-link">Home</a>
        <a href="/logout" class="btn btn-secondary btn-small" onclick="return confirm('Are you sure you want to logout?')">Logout</a>
      </nav>
    </div>
  </header>

  <div class="container">
    <main class="main-content">
      <div class="form-container">
        <h2 class="form-title">Create New Post</h2>
        <p class="form-subtitle">Share your thoughts with the world</p>

        <% if (error) { %>
          <div class="alert alert-error">
            <%= error %>
          </div>
        <% } %>

        <form action="/posts" method="POST" class="post-form" id="postForm">
          <div class="form-group">
            <label for="title">Title *</label>
            <input 
              type="text" 
              id="title" 
              name="title" 
              class="form-input" 
              placeholder="Enter post title"
              maxlength="200"
              required
            >
          </div>

          <div class="form-group">
            <label for="categories">Categories (comma-separated)</label>
            <input 
              type="text" 
              id="categories" 
              name="categories" 
              class="form-input" 
              placeholder="e.g., Technology, Travel, Food"
            >
            <small class="form-hint">Separate multiple categories with commas</small>
          </div>

          <div class="form-group">
            <label for="tags">Tags (comma-separated)</label>
            <input 
              type="text" 
              id="tags" 
              name="tags" 
              class="form-input" 
              placeholder="e.g., javascript, nodejs, tutorial"
            >
            <small class="form-hint">Separate multiple tags with commas</small>
          </div>

          <div class="form-group">
            <label>Images</label>
            <div class="image-upload-section">
              <input 
                type="file" 
                id="imageUpload" 
                accept="image/*" 
                multiple
                style="display: none;"
              >
              <button type="button" class="btn btn-secondary" onclick="document.getElementById('imageUpload').click()">
                Upload Images
              </button>
              <div id="imagePreview" class="image-preview-grid"></div>
              <div id="imageInputs"></div>
            </div>
          </div>

          <div class="form-group">
            <label for="content">Content * (Markdown supported)</label>
            <div class="markdown-editor">
              <div class="markdown-toolbar">
                <button type="button" class="toolbar-btn" onclick="insertMarkdown('**', '**')" title="Bold">
                  <strong>B</strong>
                </button>
                <button type="button" class="toolbar-btn" onclick="insertMarkdown('*', '*')" title="Italic">
                  <em>I</em>
                </button>
                <button type="button" class="toolbar-btn" onclick="insertMarkdown('## ', '')" title="Heading">
                  H
                </button>
                <button type="button" class="toolbar-btn" onclick="insertMarkdown('[', '](url)')" title="Link">
                  🔗
                </button>
                <button type="button" class="toolbar-btn" onclick="insertMarkdown('`', '`')" title="Code">
                  &lt;/&gt;
                </button>
                <button type="button" class="toolbar-btn" onclick="insertMarkdown('- ', '')" title="List">
                  ☰
                </button>
              </div>
              <textarea 
                id="content" 
                name="content" 
                class="form-textarea markdown-input" 
                placeholder="Write your post content here... Markdown is supported!"
                required
              ></textarea>
            </div>
            <small class="form-hint">
              Supports Markdown: **bold**, *italic*, ## headings, [links](url), `code`, lists, and more
            </small>
          </div>

          <div class="form-actions">
            <a href="/" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary">Publish Post</button>
          </div>
        </form>
      </div>
    </main>
  </div>

  <footer class="footer">
    <div class="container">
      <p>&copy; <%= currentYear %> My Blog. Built with Node.js, Express & EJS</p>
    </div>
  </footer>

  <script>
    const uploadedImages = [];

    // Handle image upload
    document.getElementById('imageUpload').addEventListener('change', async function(e) {
      const files = e.target.files;
      const formData = new FormData();
      
      for (let file of files) {
        formData.append('images', file);
      }

      try {
        const response = await fetch('/upload/images', {
          method: 'POST',
          body: formData
        });

        const data = await response.json();
        
        if (data.success) {
          data.imageUrls.forEach((url, index) => {
            uploadedImages.push(url);
            addImagePreview(url, data.filenames[index]);
          });
        } else {
          alert('Upload failed: ' + data.error);
        }
      } catch (error) {
        alert('Upload failed: ' + error.message);
      }

      e.target.value = '';
    });

    function addImagePreview(url, filename) {
      const preview = document.getElementById('imagePreview');
      const inputs = document.getElementById('imageInputs');
      
      const div = document.createElement('div');
      div.className = 'image-preview-item';
      div.innerHTML = `
        <img src="${url}" alt="Preview">
        <button type="button" class="remove-image-btn" onclick="removeImage('${url}', '${filename}')">×</button>
        <input type="hidden" name="images" value="${url}">
      `;
      preview.appendChild(div);
    }

    async function removeImage(url, filename) {
      if (!confirm('Remove this image?')) return;

      try {
        await fetch(`/upload/image/${filename}`, {
          method: 'DELETE'
        });

        const index = uploadedImages.indexOf(url);
        if (index > -1) {
          uploadedImages.splice(index, 1);
        }

        // Remove preview
        const previews = document.querySelectorAll('.image-preview-item');
        previews.forEach(preview => {
          if (preview.querySelector(`input[value="${url}"]`)) {
            preview.remove();
          }
        });
      } catch (error) {
        alert('Failed to remove image: ' + error.message);
      }
    }

    function insertMarkdown(before, after) {
      const textarea = document.getElementById('content');
      const start = textarea.selectionStart;
      const end = textarea.selectionEnd;
      const text = textarea.value;
      const selectedText = text.substring(start, end);
      
      const newText = text.substring(0, start) + before + selectedText + after + text.substring(end);
      textarea.value = newText;
      
      textarea.focus();
      textarea.selectionStart = start + before.length;
      textarea.selectionEnd = start + before.length + selectedText.length;
    }
  </script>
</body>
</html>
