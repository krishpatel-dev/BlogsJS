<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= post.title %> - My Blog</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&family=Playfair+Display:wght@700;900&display=swap" rel="stylesheet">
</head>
<body>
  <header class="header">
    <div class="header-content">
      <h1 class="logo"><a href="/" style="text-decoration: none; color: inherit;">✍️ My Blog</a></h1>
      <nav>
        <a href="/" class="nav-link">Home</a>
        <% if (isAuthenticated) { %>
          <a href="/posts/new" class="btn btn-primary btn-small">New Post</a>
          <a href="/logout" class="btn btn-secondary btn-small" onclick="return confirm('Are you sure you want to logout?')">Logout</a>
        <% } else { %>
          <a href="/login" class="btn btn-secondary btn-small">Login</a>
          <a href="/register" class="btn btn-primary btn-small">Register</a>
        <% } %>
      </nav>
    </div>
  </header>

  <div class="container">
    <main class="main-content">
      <article class="post-detail">
        <div class="post-detail-header">
          <h1 class="post-detail-title"><%= post.title %></h1>
          
          <div class="post-detail-meta">
            <span class="post-author">By <%= post.author.username %></span>
            <span class="separator">•</span>
            <span class="post-date"><%= new Date(post.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></span>
            <% if (post.updatedAt && post.updatedAt.toString() !== post.createdAt.toString()) { %>
              <span class="separator">•</span>
              <span class="post-updated">Updated <%= new Date(post.updatedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></span>
            <% } %>
          </div>

          <% if (post.categories && post.categories.length > 0) { %>
            <div class="post-categories" style="margin-top: 1rem;">
              <% post.categories.forEach(cat => { %>
                <a href="/?category=<%= cat %>" class="category-badge"><%= cat %></a>
              <% }); %>
            </div>
          <% } %>

          <% if (post.tags && post.tags.length > 0) { %>
            <div class="post-tags" style="margin-top: 0.5rem;">
              <% post.tags.forEach(tag => { %>
                <a href="/?tag=<%= tag %>" class="tag-badge">#<%= tag %></a>
              <% }); %>
            </div>
          <% } %>
        </div>

        <% if (post.images && post.images.length > 0) { %>
          <div class="post-images">
            <% post.images.forEach(img => { %>
              <img src="<%= img %>" alt="<%= post.title %>" class="post-full-image">
            <% }); %>
          </div>
        <% } %>

        <div class="post-detail-content markdown-content">
          <%- post.htmlContent %>
        </div>

        <div class="post-detail-actions">
          <a href="/" class="btn btn-secondary">← Back to Home</a>
          <% if (isAuthenticated && currentUser && post.author._id.toString() === currentUser._id.toString()) { %>
            <div class="action-buttons">
              <a href="/posts/<%= post._id %>/edit" class="btn btn-primary">Edit Post</a>
              <form action="/posts/<%= post._id %>?_method=DELETE" method="POST" style="display: inline;">
                <button type="submit" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete this post?')">Delete Post</button>
              </form>
            </div>
          <% } %>
        </div>
      </article>

      <!-- Comments Section -->
      <section class="comments-section" id="comments">
        <h2 class="comments-title">Comments (<%= comments.length %>)</h2>

        <% if (isAuthenticated) { %>
          <div class="comment-form-container">
            <h3>Leave a Comment</h3>
            <form action="/posts/<%= post._id %>/comments" method="POST" class="comment-form">
              <textarea 
                name="content" 
                class="comment-textarea" 
                placeholder="Share your thoughts..."
                required
              ></textarea>
              <button type="submit" class="btn btn-primary">Post Comment</button>
            </form>
          </div>
        <% } else { %>
          <div class="comment-login-prompt">
            <p>Please <a href="/login">login</a> or <a href="/register">register</a> to leave a comment.</p>
          </div>
        <% } %>

        <div class="comments-list">
          <% if (comments.length === 0) { %>
            <p class="no-comments">No comments yet. Be the first to comment!</p>
          <% } else { %>
            <% comments.forEach(comment => { %>
              <div class="comment">
                <div class="comment-header">
                  <span class="comment-author"><%= comment.author.username %></span>
                  <span class="comment-date"><%= new Date(comment.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %></span>
                </div>
                <div class="comment-content">
                  <%= comment.content %>
                </div>
                <div class="comment-actions">
                  <% if (isAuthenticated) { %>
                    <button class="comment-reply-btn" onclick="toggleReplyForm('<%= comment._id %>')">Reply</button>
                  <% } %>
                  <% if (isAuthenticated && currentUser && comment.author._id.toString() === currentUser._id.toString()) { %>
                    <form action="/comments/<%= comment._id %>?_method=DELETE" method="POST" style="display: inline;">
                      <button type="submit" class="comment-delete-btn" onclick="return confirm('Delete this comment?')">Delete</button>
                    </form>
                  <% } %>
                </div>

                <!-- Reply Form -->
                <% if (isAuthenticated) { %>
                  <div id="reply-form-<%= comment._id %>" class="reply-form" style="display: none;">
                    <form action="/comments/<%= comment._id %>/reply" method="POST">
                      <textarea 
                        name="content" 
                        class="comment-textarea" 
                        placeholder="Write a reply..."
                        required
                      ></textarea>
                      <div class="reply-form-actions">
                        <button type="button" class="btn btn-secondary btn-small" onclick="toggleReplyForm('<%= comment._id %>')">Cancel</button>
                        <button type="submit" class="btn btn-primary btn-small">Post Reply</button>
                      </div>
                    </form>
                  </div>
                <% } %>

                <!-- Replies -->
                <% if (comment.replies && comment.replies.length > 0) { %>
                  <div class="replies">
                    <% comment.replies.forEach(reply => { %>
                      <div class="comment reply">
                        <div class="comment-header">
                          <span class="comment-author"><%= reply.author.username %></span>
                          <span class="comment-date"><%= new Date(reply.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %></span>
                        </div>
                        <div class="comment-content">
                          <%= reply.content %>
                        </div>
                        <% if (isAuthenticated && currentUser && reply.author._id.toString() === currentUser._id.toString()) { %>
                          <div class="comment-actions">
                            <form action="/comments/<%= reply._id %>?_method=DELETE" method="POST" style="display: inline;">
                              <button type="submit" class="comment-delete-btn" onclick="return confirm('Delete this reply?')">Delete</button>
                            </form>
                          </div>
                        <% } %>
                      </div>
                    <% }); %>
                  </div>
                <% } %>
              </div>
            <% }); %>
          <% } %>
        </div>
      </section>
    </main>
  </div>

  <footer class="footer">
    <div class="container">
      <p>&copy; <%= currentYear %> My Blog. Built with Node.js, Express & EJS</p>
    </div>
  </footer>

  <script>
    function toggleReplyForm(commentId) {
      const form = document.getElementById('reply-form-' + commentId);
      form.style.display = form.style.display === 'none' ? 'block' : 'none';
    }
  </script>
</body>
</html>
