<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= post.title %> - My Blog</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&family=Playfair+Display:wght@700;900&display=swap" rel="stylesheet">
</head>
<body>
  <header class="header">
    <div class="header-content">
      <h1 class="logo">✍️ My Blog</h1>
      <nav>
        <a href="/" class="nav-link">Home</a>
        <a href="/posts/new" class="btn btn-primary">New Post</a>
      </nav>
    </div>
  </header>

  <div class="container">
    <main class="main-content">
      <article class="post-detail">
        <div class="post-detail-header">
          <h1 class="post-detail-title"><%= post.title %></h1>
          <div class="post-detail-meta">
            <span class="post-author">By <%= post.author %></span>
            <span class="separator">•</span>
            <span class="post-date"><%= post.date %></span>
          </div>
        </div>

        <div class="post-detail-content">
          <%= post.content %>
        </div>

        <div class="post-detail-actions">
          <a href="/" class="btn btn-secondary">← Back to Home</a>
          <div class="action-buttons">
            <a href="/posts/<%= post.id %>/edit" class="btn btn-primary">Edit Post</a>
            <form action="/posts/<%= post.id %>?_method=DELETE" method="POST" style="display: inline;">
              <button type="submit" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete this post?')">
                Delete Post
              </button>
            </form>
          </div>
        </div>
      </article>
    </main>
  </div>

  <footer class="footer">
    <div class="container">
      <p>&copy; <%= currentYear %> My Blog. Built with Node.js, Express & EJS</p>
    </div>
  </footer>
</body>
</html>
